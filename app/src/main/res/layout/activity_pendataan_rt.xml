<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#E8F5E9">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2E7D32"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu"
            app:tint="#FFFFFF"
            android:contentDescription="Menu" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="PENDATAAN RT"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nav_bar_bawah"
        android:layout_below="@id/header"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Wilayah"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pilih Kelurahan"
                android:textColor="#000000"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinner_kelurahan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_elegant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pilih Jalan / Lingkungan Kampung"
                android:textColor="#000000"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinner_alamat_jalan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_elegant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih RT"
                        android:textColor="#000000"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/spinner_rt"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_elegant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih RW"
                        android:textColor="#000000"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/spinner_rw"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_elegant" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kode Pos Wilayah"
                android:textColor="#000000"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/et_detail_no_rumah"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_elegant"
                android:hint="Kode Pos Otomatis..."
                android:textColor="#000000"
                android:textColorHint="#7F7F7F"
                android:paddingHorizontal="15dp"
                android:focusable="false"
                android:clickable="false"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Identitas Keluarga"
                android:textStyle="bold"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/et_no_kk"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_elegant"
                android:hint="Nomor KK"
                android:textColor="#000000"
                android:textColorHint="#7F7F7F"
                android:inputType="number"
                android:paddingHorizontal="15dp"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/et_nama_kepala"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_elegant"
                android:hint="Nama Kepala Keluarga"
                android:textColor="#000000"
                android:textColorHint="#7F7F7F"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="15dp"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jumlah Penghuni Rumah Tangga"
                android:textColor="#000000"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinner_jml_penghuni"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_elegant"
                android:prompt="@string/pilih_jml_penghuni" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Dokumen Pendukung Bukti Warga"
                android:textStyle="bold"
                android:textColor="#333333" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF">
                <Button
                    android:id="@+id/btn_upload_dokumen"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:backgroundTint="#3A86FF"
                    android:text="FOTO KTP / KK WARGA"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:icon="@drawable/ic_cloud_upload" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Fasilitas Sanitasi"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Punya Jamban Sendiri?"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_kepemilikan_jamban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_jamban_sendiri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sendiri" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_jamban_bersama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bersama" android:textColor="#000000" android:layout_marginStart="15dp" />
                <RadioButton android:id="@+id/rb_jamban_menumpang" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menumpang" android:textColor="#000000" android:layout_marginStart="15dp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jenis Jamban"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_jenis_jamban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_leher_angsa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leher Angsa" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_plengsengan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plengsengan" android:textColor="#000000" android:layout_marginStart="15dp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tempat Buangan"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_tempat_buangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp">
                <RadioButton android:id="@+id/rb_septic_tank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tangki Septic (Septic Tank)" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_ipal_spal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IPAL/SPAL (Sistem Terpusat)" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_lubang_tanah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lubang tanah" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_selokan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selokan" android:textColor="#000000" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Pengelolaan Air Limbah Non-Tinja (Greywater)"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Saluran Pembuangan Air Bekas (Mandi, Cuci Baju/Piring):"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_greywater"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp">
                <RadioButton android:id="@+id/rb_greywater_tertutup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saluran Tertutup" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_greywater_terbuka" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saluran Terbuka" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_greywater_tanah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Langsung ke Tanah" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_greywater_resapan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Masuk ke Sumur Resapan" android:textColor="#000000" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Riwayat Penyedotan Tangki Septik"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Apakah Tangki Septik Pernah Disedot?"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_pernah_sedot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">
                <RadioButton android:id="@+id/rb_sedot_pernah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pernah" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_sedot_belum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Belum Pernah" android:textColor="#000000" android:layout_marginStart="15dp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layout_detail_sedot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berapa Kali Disedot?"
                    android:textColor="#000000"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spinner_frekuensi_sedot"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_elegant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Kapan Terakhir Kali Disedot? (3 - 5 Tahun Terakhir)"
                    android:textColor="#000000"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/spinner_waktu_sedot"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_elegant" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jarak Sumber Air Minum ke Penampungan Tinja (Septic Tank)"
                android:textColor="#000000"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinner_jarak_air"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_elegant"
                android:prompt="@string/pilih_jarak_air" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Penilaian Akhir Kelayakan"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Status Kelayakan"
                android:textColor="#000000" />

            <RadioGroup
                android:id="@+id/rg_kelayakan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">
                <RadioButton android:id="@+id/rb_layak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Layak" android:textColor="#000000" />
                <RadioButton android:id="@+id/rb_tidak_layak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tidak Layak" android:textColor="#000000" android:layout_marginStart="15dp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Lokasi Geotagging"
                android:textStyle="bold"
                android:textColor="#333333" />

            <org.osmdroid.views.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btn_simpan"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#007AFF"
                android:text="SIMPAN DATA"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/nav_bar_bawah"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#2E7D32"
        android:orientation="horizontal"
        android:weightSum="5">


        <LinearLayout android:id="@+id/nav_rt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_dialog_map" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sanitasi RT" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_komunal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#A5D6A7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Komunal" android:textColor="#A5D6A7" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_spal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_compass" app:tint="#A5D6A7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPAL" android:textColor="#A5D6A7" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_pelaporan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_call" app:tint="#A5D6A7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pelaporan" android:textColor="#A5D6A7" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_riwayat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#A5D6A7" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Riwayat" android:textColor="#A5D6A7" android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout> </RelativeLayout>